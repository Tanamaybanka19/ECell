# Supabase — project settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Never expose to the browser. Used by /app/api/admin/* routes.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin login (shared username/password gate for /admin)
# These values should match the Netlify env vars set for the production login gate.
# On Netlify set ADMIN_USERNAME and ADMIN_PASSWORD via the UI; local dev should
# have matching values in .env.local.
ADMIN_USERNAME=ecell_admin
ADMIN_PASSWORD=secure-admin-pass

# Public origin used for canonical links, sitemap and Open Graph tags.
# Optional on Netlify (the `URL` env var is used instead), required for a
# custom domain or any other host.
NEXT_PUBLIC_SITE_URL=https://ecell-sxcm.netlify.app
